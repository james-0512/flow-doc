# docker-compose 用的環境變數。複製成 .env 後填值（.env 不進版控）。
# 各變數的完整說明見 docker-compose.yml 開頭註解。
#
# repo 一律由容器自己 clone／fetch 到常駐 volume，host 上什麼都不用先準備
# （不再有 bind mount host 路徑的模式，理由見 DECISIONS D15）。
#
# ⚠ 首次啟用要重做 baseline：flow-chains.json 記著 platform 與該環境的模組解析
#   結果，換分析環境的第一輪會大量 changed 被熔斷器擋下（不會寫壞東西，但那輪
#   白跑）。先在容器內跑一次 trace＋pack 並 commit 成新 baseline。


# ── repo 來源 ───────────────────────────────────────────────────────────

# 目標 repo 與手冊 repo 的 git URL。私有 repo 靠下面的 GH_TOKEN 認證。
# ref 是分支名（不填用 main）。clone 一律完整歷史——改名偵測要 baseline..HEAD。
TARGET_REPO_URL=
TARGET_REPO_REF=main
MANUALS_REPO_URL=
MANUALS_REPO_REF=main

# 目標 repo 的安裝與 codegen 指令，clone 後在容器內執行。
# 不填就用下面這組預設值；明確設成空字串代表「不做這一步」。
# 安裝只在 lockfile 變動或 node_modules 不在時才跑，codegen 每輪都跑。
# node_modules 缺了熔斷器會擋下整輪；generated 檔缺了 loop 直接拒跑（exit 3）。
TARGET_INSTALL_CMD=pnpm install --frozen-lockfile
TARGET_CODEGEN_CMD=pnpm generate:components-dts


# ── 其餘設定 ────────────────────────────────────────────────────────────

# 手冊 repo 內的目標目錄名（預設 mPHR_Frontend，可不填）
FLOW_DOC_TARGET_NAME=mPHR_Frontend

# narrate 用。缺了 loop 照樣跑，章節進待補佇列。
# ⚠ 容器裡請填這個。不填會退回訂閱方案，而容器內沒有 Claude Code 的登入憑證，
#   也刻意不裝那個 267 MB 的平台 binary（見 DECISIONS D16）——那條路是給本機用的。
ANTHROPIC_API_KEY=

# 私有 repo 的 clone，以及 PR 模式的 push／開 PR（gh auth token）
GH_TOKEN=

# loop commit 的身份（不填則用 flow-doc-loop / flow-doc-loop@localhost）
GIT_USER_NAME=
GIT_USER_EMAIL=

# 站台標題（不填用預設「業務流程手冊」）
FLOW_DOC_SITE_TITLE=

# web 對外埠（預設 8080）
SITE_PORT=8080
